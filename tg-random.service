[Unit]
Description=Telegram Random User Bot
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/random-bot
EnvironmentFile=/opt/random-bot/.env
ExecStart=/opt/random-bot/.venv/bin/python bot.py
StandardOutput=append:/opt/random-bot/bot.log
StandardError=append:/opt/random-bot/bot.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
